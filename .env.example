# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on Privacy/Terms/confirmation pages as the contact address for data
# requests. Leave blank in dev; must be set before production launch.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase (client owns the production project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private object storage — any S3-compatible provider works (Cloudflare R2,
# Supabase Storage, Backblaze B2, MinIO, ...). STORAGE_ENDPOINT is the full
# base URL, not just an account ID, since that varies by provider:
#   Cloudflare R2:     https://<account-id>.r2.cloudflarestorage.com
#   Supabase Storage:  https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
# R2 uses "auto"; Supabase Storage and most others need their real region
# (e.g. the region your Supabase project is in).
STORAGE_REGION=auto

# AI provider — client-owned Gemini API key, server-only, never exposed to the browser
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Document retention (days) — used by the retention/deletion job
RETENTION_DAYS=30

# Shared secret for GET /api/cron/retention (the scheduled deletion sweep).
# Generate a long random value, e.g. `openssl rand -hex 32`. Leave unset in
# dev — the endpoint refuses every request until this is set.
CRON_SECRET=

# Admin bootstrap (optional — see README for creating the first admin user)
ADMIN_ALLOWED_EMAILS=
